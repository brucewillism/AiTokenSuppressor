# Application
APP_NAME=AI Token Suppressor
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-secure-random-string-min-32-chars
API_KEY=ats-dev-api-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://ats:ats_secret@postgres:5432/ai_token_suppressor
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis (container ats-redis no compose — porta host 8106)
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# LLM Providers (proxy /v1 — ordem de fallback abaixo)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# JWT
JWT_SECRET_KEY=change-me-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Payload Limits
MAX_PAYLOAD_SIZE_MB=10
MAX_MESSAGES=500

# Compression
DEFAULT_COMPRESSION_STRATEGY=fast
COMPRESS_LIGHTWEIGHT_TOKEN_THRESHOLD=400
COMPRESS_SKIP_SEMANTIC_LOSS_BELOW_TOKENS=800
TARGET_COMPRESSION_RATIO=0.4

# RAG
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5

# Context Window
MAX_CONTEXT_TOKENS=128000
SLIDING_WINDOW_SIZE=50

# Cost Estimation (USD per 1M tokens)
COST_CLAUDE_INPUT=3.0
COST_CLAUDE_OUTPUT=15.0
COST_OPENAI_INPUT=2.5
COST_OPENAI_OUTPUT=10.0
COST_GEMINI_INPUT=1.25
COST_GEMINI_OUTPUT=5.0

# CORS (inclua a URL do frontend/produção)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://191.252.210.60:8100

# Docker: use production para carregar só variáveis do compose (não .env da imagem)
APP_ENV=production

# Proxy nginx em /api (produção/VPS) — corrige Swagger em /api/docs
ROOT_PATH=/api

# OpenAI proxy /v1/chat/completions (Cursor: base URL http://SEU_IP:8100/v1)
PROXY_DEFAULT_STRATEGY=fast
PROXY_PIPELINE=compress
PROXY_USE_MEMORY=false
PROXY_USE_OLLAMA=false
PROXY_SKIP_OPTIMIZE=false
# Após compressão no supressor: tenta nesta ordem
PROXY_PROVIDER_FALLBACK=groq,openai,anthropic,gemini,deepseek,ollama

# Frontend (build Docker)
VITE_API_URL=/api
VITE_API_KEY=ats-dev-api-key-change-in-production
# URL direta da API exposta no host (opcional — link de diagnóstico na UI)
# VITE_API_DIRECT_URL=http://SEU_IP:8105

# --- VPS: Postgres/Redis/Ollama no host (sem containers no compose) ---
# DATABASE_URL=postgresql+asyncpg://postgres:SUA_SENHA@host.docker.internal:5439/ats_db
# REDIS_URL=redis://host.docker.internal:6379/0
# CELERY_BROKER_URL=redis://host.docker.internal:6379/1
# CELERY_RESULT_BACKEND=redis://host.docker.internal:6379/2
# OLLAMA_BASE_URL=http://host.docker.internal:11999
# CORS_ORIGINS=http://SEU_IP:8100
# VITE_API_DIRECT_URL=http://SEU_IP:8105

# LiteLLM Gateway
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-litellm-master-key
